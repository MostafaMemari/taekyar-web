generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum MenuItemType {
  PAGE
  POST
  CATEGORY
  TAG
  CUSTOM
}

enum MenuLocation {
  HEADER_DESKTOP
  HEADER_MOBILE
  FOOTER_QUICK
  FOOTER_BLOG
}

model MenuItem {
  id         Int          @id @default(autoincrement())
  title      String
  type       MenuItemType
  customUrl  String?
  pageId     Int?
  page       Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  postId     Int?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  categoryId Int?
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tagId      Int?
  tag        Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentId   Int?
  parent     MenuItem?    @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children   MenuItem[]   @relation("MenuHierarchy")
  order      Int          @default(0)
  location   MenuLocation
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@index([parentId])
  @@index([location, order])
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Post {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  title           String
  excerpt         String?
  categories      Category[]
  tags            Tag[]
  date            DateTime?
  readTimeMinutes Int?
  content         Json?
  coverImage      String?
  coverImageAlt   String?
  status          PostStatus  @default(PUBLISHED)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  comments        Comment[]
  seo             SeoMetadata?
  menuItems       MenuItem[]
}

model Category {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  slug            String     @unique
  path            String     @unique
  parentId        Int?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children        Category[] @relation("CategoryHierarchy")
  image           String?
  imageAlt        String?
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  posts           Post[]
  seo             SeoMetadata?
  menuItems       MenuItem[]

  @@index([parentId])
}

model Tag {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  slug            String   @unique
  image           String?
  imageAlt        String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  posts           Post[]
  seo             SeoMetadata?
  menuItems       MenuItem[]
}

model Page {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  title         String
  content       Json?
  coverImage    String?
  coverImageAlt String?
  status        PostStatus  @default(PUBLISHED)
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  seo           SeoMetadata?
  menuItems     MenuItem[]
}

model SeoMetadata {
  id             Int       @id @default(autoincrement())
  postId         Int?      @unique
  post           Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId     Int?      @unique
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tagId          Int?      @unique
  tag            Tag?      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  pageId         Int?      @unique
  page           Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  seoTitle       String?
  seoDescription String?
  keywords       String?
  canonical      String?
  robotsTags     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model Comment {
  id           String        @id @default(cuid())
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int
  author       String
  role         String
  isTeamAuthor Boolean       @default(false)
  date         String
  message      String
  ipHash       String?
  status       CommentStatus @default(PENDING)
  parentId     String?
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentReplies")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
}

model SiteSettings {
  id                    Int      @id @default(1)
  siteName              String
  siteTitle             String
  siteDescription       String
  defaultSeoTitle       String?
  defaultSeoDescription String?
  logoImage             String?
  logoImageAlt          String?
  faviconImage          String?
  faviconImageAlt       String?
  defaultOgImage        String?
  defaultOgImageAlt     String?
  telegramUrl           String?
  instagramUrl          String?
  youtubeUrl            String?
  twitterUrl            String?
  appDownloadUrl        String?
  updatedAt             DateTime @updatedAt
}
